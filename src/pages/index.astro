---
import Layout from '../layouts/Layout.astro';
import { cv } from '../data/cv';
---
<Layout>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <div class="document">
    <header class="identity">
      <h1>Juan Pablo <br />Arceo Noriega</h1>
      <p class="role">{cv.role}</p>
      <p class="location">{cv.location}</p>
      <a class="github" href={cv.github}>GitHub <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M4 3h9v9" stroke="currentColor" stroke-width="1.5" /></svg><span class="handle">github.com/jpabloan</span></a>
      <nav aria-label="Secciones del currículum">
        <a href="#perfil">Perfil</a>
        <a href="#experiencia">Experiencia</a>
        <a href="#habilidades">Habilidades</a>
        <a href="#formacion">Formación</a>
        <a href="#idiomas">Idiomas</a>
      </nav>
    </header>
    <main id="contenido" tabindex="-1">
      <section id="perfil" aria-labelledby="perfil-heading">
        <h2 id="perfil-heading">Perfil profesional</h2>
        <p class="intro">{cv.profile[0]}</p>
        <p class="current-focus">{cv.profile[1]}</p>
      </section>
      <section id="experiencia" aria-labelledby="experiencia-heading">
        <h2 id="experiencia-heading">Experiencia</h2>
        <article>
          <header class="job-header">
            <div><h3>{cv.experience.company}</h3><p class="job-role">{cv.experience.role}</p></div>
            <p class="dates"><time datetime={cv.experience.start}>{cv.experience.start}</time><span aria-hidden="true"> — </span><span class="sr-only"> a </span><time datetime={cv.experience.end}>{cv.experience.end}</time></p>
          </header>
          <ul class="contributions">
            {cv.experience.contributions.map(([title, description]) => <li><h4>{title}</h4><p>{description}</p></li>)}
          </ul>
          <div class="technologies"><h4>Tecnologías utilizadas en Enviatodo</h4><p>{cv.experience.technologies}</p></div>
        </article>
      </section>
      <section id="habilidades" aria-labelledby="habilidades-heading">
        <h2 id="habilidades-heading">Habilidades técnicas</h2>
        <dl class="skills">{cv.skills.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
      </section>
      <section id="formacion" aria-labelledby="formacion-heading">
        <h2 id="formacion-heading">Formación</h2><p>{cv.education}</p>
      </section>
      <section id="idiomas" aria-labelledby="idiomas-heading">
        <h2 id="idiomas-heading">Idiomas</h2>
        <dl class="languages">{cv.languages.map(([language, level]) => <div><dt>{language}</dt><dd>{level}</dd></div>)}</dl>
      </section>
    </main>
  </div>
</Layout>
