---
const { cv, lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<a class="skip-link" href="#contenido">
    {cv.ui.skipToContent}
</a>
<div class="document">
    <header class="identity">
        <h1>
            Juan Pablo <br />
            Arceo Noriega
        </h1>
        <p class="role">{cv.role}</p>
        <p class="location">{cv.location}</p>
        <a class="github" href={cv.github}>
            GitHub
            <svg
                aria-hidden="true"
                width="14"
                height="14"
                viewBox="0 0 16 16"
                fill="none"
            >
                <path
                    d="M3 13 13 3M4 3h9v9"
                    stroke="currentColor"
                    stroke-width="1.5"
                />
            </svg>
            <span class="handle">github.com/jpabloan</span>
        </a>
        <div class="language-switcher" aria-label={cv.ui.languageSwitcherLabel}>
            <a
                href={`${base}/`}
                aria-current={lang === "es" ? "page" : undefined}
            >
                ES
            </a>
            <span aria-hidden="true">/</span>
            <a
                href={`${base}/en/`}
                aria-current={lang === "en" ? "page" : undefined}
            >
                EN
            </a>
        </div>
        <nav aria-label={cv.ui.navigationLabel}>
            <a href="#perfil">{cv.ui.sections.profile}</a>
            <a href="#experiencia">{cv.ui.sections.experience}</a>
            <a href="#habilidades">{cv.ui.sections.skills}</a>
            <a href="#formacion">{cv.ui.sections.education}</a>
            <a href="#idiomas">{cv.ui.sections.languages}</a>
        </nav>
    </header>
    <main id="contenido" tabindex="-1">
        <section id="perfil" aria-labelledby="perfil-heading">
            <h2 id="perfil-heading">{cv.ui.headings.profile}</h2>
            <p class="intro">{cv.profile[0]}</p>
            <p class="current-focus">{cv.profile[1]}</p>
        </section>
        <section id="experiencia" aria-labelledby="experiencia-heading">
            <h2 id="experiencia-heading">{cv.ui.headings.experience}</h2>
            <article>
                <header class="job-header">
                    <div>
                        <h3>{cv.experience.company}</h3>
                        <p class="job-role">{cv.experience.role}</p>
                    </div>
                    <p class="dates">
                        <time datetime={cv.experience.start}>
                            {cv.experience.start}
                        </time>
                        <span aria-hidden="true"> — </span>
                        <span class="sr-only"> a </span>
                        <time datetime={cv.experience.end}>
                            {cv.experience.end}
                        </time>
                    </p>
                </header>
                <ul class="contributions">
                    {cv.experience.contributions.map(([title, description]) => (
                        <li>
                            <h4>{title}</h4>
                            <p>{description}</p>
                        </li>
                    ))}
                </ul>
                <div class="technologies">
                    <h4>{cv.ui.technologies}</h4>
                    <p>{cv.experience.technologies}</p>
                </div>
            </article>
        </section>
        <section id="habilidades" aria-labelledby="habilidades-heading">
            <h2 id="habilidades-heading">{cv.ui.headings.skills}</h2>
            <dl class="skills">
                {cv.skills.map(([label, value]) => (
                    <div>
                        <dt>{label}</dt>
                        <dd>{value}</dd>
                    </div>
                ))}
            </dl>
        </section>
        <section id="formacion" aria-labelledby="formacion-heading">
            <h2 id="formacion-heading">{cv.ui.headings.education}</h2>
            <p>{cv.education}</p>
        </section>
        <section id="idiomas" aria-labelledby="idiomas-heading">
            <h2 id="idiomas-heading">{cv.ui.headings.languages}</h2>
            <dl class="languages">
                {cv.languages.map(([language, level]) => (
                    <div>
                        <dt>{language}</dt>
                        <dd>{level}</dd>
                    </div>
                ))}
            </dl>
        </section>
    </main>
    <footer id="document-footer" class="document-footer">
        <p class="footer-credits">{cv.developedBy} © 2026</p>
        <hr />
        <a class="back-to-top" href="#top">
            ↑ {cv.ui.backToTop}
        </a>
    </footer>
</div>
