---
import "../styles/global.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const {
    lang = "es",
    title = "Juan Pablo Arceo Noriega — Backend Developer",
    description = "Juan Pablo Arceo Noriega. Desarrollador Backend con 5 años de experiencia profesional en PHP, CodeIgniter, MySQL e integración de APIs REST. Estado de México, México.",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f8f9f7" />
        <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
        <title>{title}</title>
    </head>
    <body>
        <slot />
    </body>
</html>
