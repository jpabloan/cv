const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Juan Pablo Arceo Noriega. Desarrollador Backend con 5 años de experiencia profesional en PHP, CodeIgniter, MySQL e integración de APIs REST. Monterrey, México." />
    <meta name="theme-color" content="#f8f9f7" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
